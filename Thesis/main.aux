\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces UMAP representation of the dataset coloured according to SingleR annotations. The strong intermixing between populations illustrates the difficulty of relying exclusively on unsupervised clustering for cell-type identification.}}{18}{figure.caption.17}\protected@file@percent }
