\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Dot plot showing the top five most highly expressed genes per cell type in a well-differentiated sample. FOXP3 expression is specifically elevated in Tregs and absent in CD4+ and CD8+ T-cell populations, reflecting biologically expected behaviour successfully captured by SingleR. Plasma cells also show strong expression of canonical plasma-cell markers such as TNFRSF17 and MZB1. Although other cell types have highly expressed genes that are neither specific nor canonical to the cell type they come from, they can still be differentiated thanks to other genes. This is proof of biological complexity.}}{18}{figure.caption.18}\protected@file@percent }
\newlabel{fig:Dotplot}{{3.4}{18}{Dot plot showing the top five most highly expressed genes per cell type in a well-differentiated sample. FOXP3 expression is specifically elevated in Tregs and absent in CD4+ and CD8+ T-cell populations, reflecting biologically expected behaviour successfully captured by SingleR. Plasma cells also show strong expression of canonical plasma-cell markers such as TNFRSF17 and MZB1. Although other cell types have highly expressed genes that are neither specific nor canonical to the cell type they come from, they can still be differentiated thanks to other genes. This is proof of biological complexity}{figure.caption.18}{}}
\newlabel{fig:Dotplot@cref}{{[figure][4][3]3.4}{[1][18][]18}{}{}{}}
\gdef\@@FBset@ix{\global\c@FBcnt18}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Effect of incorrect filtering using \(\lvert \log _2FC \rvert > 1\) in Epithelial and Fibroblasts signatures. Including negatively enriched genes introduced substantial bias into the enrichment signatures. Biased signatures still follow the canonical signatures of their corresponding cell types.}}{19}{figure.caption.19}\protected@file@percent }
\newlabel{fig:AddModuleScoreBAD}{{3.5}{19}{Effect of incorrect filtering using \(\lvert \log _2FC \rvert > 1\) in Epithelial and Fibroblasts signatures. Including negatively enriched genes introduced substantial bias into the enrichment signatures. Biased signatures still follow the canonical signatures of their corresponding cell types}{figure.caption.19}{}}
\newlabel{fig:AddModuleScoreBAD@cref}{{[figure][5][3]3.5}{[1][19][]19}{}{}{}}
\gdef\@@FBset@x{\global\c@FBcnt19}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Module-score enrichment plots generated using the \textbf  {mean} enrichment score obtained from \texttt  {AddModuleScore}. Using the \textbf  {sum} of enrichment scores would introduce a strong bias associated with the number of cells in each cluster. Without standardisation of the score, highly abundant populations would artificially display stronger signatures due to cluster size rather than true biological enrichment.}}{20}{figure.caption.20}\protected@file@percent }
\newlabel{fig:AddModuleScore}{{3.6}{20}{Module-score enrichment plots generated using the \textbf {mean} enrichment score obtained from \texttt {AddModuleScore}. Using the \textbf {sum} of enrichment scores would introduce a strong bias associated with the number of cells in each cluster. Without standardisation of the score, highly abundant populations would artificially display stronger signatures due to cluster size rather than true biological enrichment}{figure.caption.20}{}}
\newlabel{fig:AddModuleScore@cref}{{[figure][6][3]3.6}{[1][19][]20}{}{}{}}
\gdef\@@FBset@xi{\global\c@FBcnt20}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Example of violin-plot validation. Fortunately, no sample in the final dataset required this final validation layer. Therefore, a representative example was generated to illustrate how violin plots can be used as an additional validation strategy. In this example, the expression distributions of canonical CD4 and Treg markers clearly differ between populations, supporting their separation despite partial overlap in previous enrichment analyses.}}{21}{figure.caption.21}\protected@file@percent }
