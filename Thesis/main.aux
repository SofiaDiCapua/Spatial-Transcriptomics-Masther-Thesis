\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces Example illustrating how the number of unique genes complicates the analysis with a UMAP\textsuperscript  {a}. Figure A corresponds to the dataset used in this thesis, generated using a ST technology with only 377 unique genes. Figure B was extracted from \href  {https://medium.com/@mohamed.y.elsadec_56085/a-comparative-analysis-of-clustering-scrna-seq-data-using-pca-based-and-gnn-driven-approaches-24c9fb8d5ec8}{this blog} and corresponds to a single-cell technology dataset. }}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:Figure12}{{1.2}{5}{Example illustrating how the number of unique genes complicates the analysis with a UMAP\textsuperscript {a}. Figure A corresponds to the dataset used in this thesis, generated using a ST technology with only 377 unique genes. Figure B was extracted from \href {https://medium.com/@mohamed.y.elsadec_56085/a-comparative-analysis-of-clustering-scrna-seq-data-using-pca-based-and-gnn-driven-approaches-24c9fb8d5ec8}{this blog} and corresponds to a single-cell technology dataset}{figure.caption.7}{}}
\newlabel{fig:Figure12@cref}{{[figure][2][1]1.2}{[1][5][]5}{}{}{}}
\gdef\@@FBset@i{\global\c@FBcnt5}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Comparison of cell type annotation in muscle-invasive bladder cancer (MIBC) using spatial versus single-cell transcriptomics. \textbf  {(A)} UMAP projection of Xenium ST data (377 genes) used in this thesis, with cell types annotated using SingleR. Cluster boundaries are diffuse and several populations overlap, reflecting the limited gene panel. \textbf  {(B)} UMAP projection of single-cell RNA-seq data from MIBC (>3{,}000 genes) used in \blx@tocontentsinit {0}\cite {Dongxu.Qiu}, with cell types annotated using simple clustering, showing well-separated clusters with clearly resolved immune subpopulations (M1, M2, dendritic cells, Tregs, CD4\textsuperscript  {+}/CD8\textsuperscript  {+} T cells). The contrast illustrates how a reduced gene panel hampers fine-grained cell type discrimination, particularly within the immune compartment.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:figure3}{{1.3}{5}{Comparison of cell type annotation in muscle-invasive bladder cancer (MIBC) using spatial versus single-cell transcriptomics. \textbf {(A)} UMAP projection of Xenium ST data (377 genes) used in this thesis, with cell types annotated using SingleR. Cluster boundaries are diffuse and several populations overlap, reflecting the limited gene panel. \textbf {(B)} UMAP projection of single-cell RNA-seq data from MIBC (>3{,}000 genes) used in \cite {Dongxu.Qiu}, with cell types annotated using simple clustering, showing well-separated clusters with clearly resolved immune subpopulations (M1, M2, dendritic cells, Tregs, CD4\textsuperscript {+}/CD8\textsuperscript {+} T cells). The contrast illustrates how a reduced gene panel hampers fine-grained cell type discrimination, particularly within the immune compartment}{figure.caption.8}{}}
\newlabel{fig:figure3@cref}{{[figure][3][1]1.3}{[1][5][]5}{}{}{}}
